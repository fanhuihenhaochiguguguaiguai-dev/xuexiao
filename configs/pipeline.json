      "model.20",
      "gate.physics",
      "gate.pwa",
      "proof.prior_browser",
      "source.cc0_base"
    ]
  },
  "tasks": [
    {
      "id": "tool.blender",
      "driver": "tool",
      "params": {
        "name": "blender"
      },
      "outputs": [
        "tool.json"
      ]
    },
    {
      "id": "tool.node",
      "driver": "tool",
      "params": {
        "name": "node"
      },
      "outputs": [
        "tool.json"
      ]
    },
    {
      "id": "gate.campus",
      "driver": "glb_gate",
      "inputs": {
        "model": "game/dist/assets/campus.glb"
      },
      "params": {
        "min_height": 10
      },
      "outputs": [
        "quality.json"
      ]
    },
    {
      "id": "gate.avatar",
      "driver": "glb_gate",
      "inputs": {
        "model": "game/dist/assets/character.glb"
      },
      "params": {
        "require_skin": true,
        "min_height": 1
      },
      "outputs": [
        "quality.json"
      ]
    },
    {
      "id": "gate.physics",
      "driver": "physics",
      "needs": [
        "tool.node",
        "gate.campus"
      ],
      "inputs": {
        "script": "game/physics-check.mjs",
        "simulation": "game/simulation.js",
        "world": "game/dist/assets/world.json",
        "lock": "game/package-lock.json"
      },
      "outputs": [
        "physics.json"
      ]
    },
    {
      "id": "game.build",
      "driver": "build",
      "needs": [
        "tool.node",
        "gate.campus",
        "gate.avatar"
      ],
      "inputs": {
        "entry": "game/game.js",
        "simulation": "game/simulation.js",
        "pwa": "game/dist/pwa.js",
        "lock": "game/package-lock.json",
        "diagnostics": "game/diagnostics.js",
        "performance_core": "game/performance-core.js",
        "water": "game/water.js"
      },
      "outputs": [
        "game.js"
      ]
    },
    {
      "id": "gate.pwa",
      "driver": "pwa_gate",
      "needs": [
        "game.build"
      ],
      "inputs": {
        "manifest": "game/dist/manifest.webmanifest",
        "html": "game/dist/index.html",
        "css": "game/dist/style.css",
        "pwa": "game/dist/pwa.js",
        "sw": "game/dist/sw.js",
        "world": "game/dist/assets/world.json",
        "campus": "game/dist/assets/campus.glb",
        "avatar": "game/dist/assets/character.glb",
        "bundle": "game/dist/game.js",
        "icon192": "game/dist/assets/app-icon-192.png",
        "icon512": "game/dist/assets/app-icon-512.png",
        "benchmark_route": "game/dist/assets/benchmark-route.json"
      },
      "outputs": [
        "quality.json"
      ]
    },
    {
      "id": "proof.prior_browser",
      "driver": "published_proof",
      "inputs": {
        "browser": "game/qa/playcanvas_browser_validation.json",
        "install": "game/qa/pwa_normal_profile_validation.json"
      },
      "params": {
        "source_commit": "2bca4c44553ef7a9cd98d9353c2c7c741994e60a"
      },
      "outputs": [
        "prior-proof.json"
      ]
    },
    {
      "id": "source.cc0_base",
      "driver": "fetch_asset",
      "inputs": {
        "existing": {
          "path": "assets/henan_campus/character/source/base.obj",
          "optional": true
        }
      },
      "params": {
        "url": "https://raw.githubusercontent.com/makehumancommunity/makehuman/master/makehuman/data/3dobjs/base.obj",
        "sha256": "8e761e6624b8f54536409135d1636da63b32486a90d4897f84e121d144f6fb4c",
        "license": "CC0 1.0",
        "allowed_hosts": [
          "raw.githubusercontent.com"
        ]
      },
      "outputs": [
        "asset.bin",
        "provenance.json"
      ]
    }
  ],
  "task_templates": {
    "reuse_building": [
      {
        "id": "route.${id}",
        "driver": "route",
        "group": "buildings",
        "inputs": {
          "model": "assets/henan_campus/project/HenanCampus.blend",
          "photos": {
            "path": "configs/local-photos/building-${id}.json",
            "optional": true
          }
        },
        "params": {
          "building_id": "${building_id}"
        },
        "outputs": [
          "route.json"
        ]
      },
      {
        "id": "model.${id}",
        "driver": "building_export",
        "group": "buildings",
        "needs": [
          "tool.blender",
          "route.${id}"
        ],
        "inputs": {
          "source": "assets/henan_campus/project/HenanCampus.blend"
        },
        "params": {
          "building_id": "${building_id}",
          "min_height": 2,
          "include_objects": "${include_objects}"
        },
        "outputs": [
          "model.glb",
          "export.json",
          "quality.json"
        ]
      }
    ]
  },
  "batches": [
