{
  "schema_version": 1,
  "cache_dir": ".campus-cache",
  "policy": {
    "max_attempts": 2,
    "retryable_codes": [
      "TIMEOUT",
      "IO_BUSY"
    ],
    "halt_group_on_failure": true
  },
  "release_targets": [
    "model.13",
    "model.01",
    "model.02",
    "model.03",
    "model.04",
    "model.05",
    "model.06",
    "model.07",
    "model.08",
    "model.09",
    "model.10",
    "model.11",
    "model.12",
    "model.14",
    "model.15",
    "model.16",
    "model.17",
    "model.18",
    "model.19",
    "model.20",
    "gate.physics",
    "gate.pwa",
    "proof.prior_browser",
    "source.cc0_base"
  ],
  "campaigns": {
    "pilot": [
      "model.13"
    ],
    "small": [
      "model.13",
      "model.01",
      "model.02"
    ],
    "trial": [
      "model.13",
      "model.01",
      "model.02",
      "model.05",
      "model.06",
      "model.15"
    ],
    "all": [
      "model.13",
